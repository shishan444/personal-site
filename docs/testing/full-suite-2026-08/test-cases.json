    {
      "control_set_id": "CS-Pglite-Real-DB",
      "data": "tests/integration/_setup.ts 启动 PGlite atelier-test，跑 drizzle migrations；_seed-helper.ts 提供 owner user + site_config + 6 agents + 5 timeline 节点 + 5 essays",
      "dependencies": "@electric-sql/pglite、drizzle-orm、drizzle migrations 0000+0001",
      "time_randomness": "timestamp 字段由 DB defaultNow；测试用 SN/slug 后缀加随机数避免冲突",
      "cleanup": "afterAll 关闭 PGlite + 删 .pglite/atelier-test 目录；uploads 资产在 .tmp-uploads-test 后 rm"
