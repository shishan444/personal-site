# ─────────────────────────────────────────────
# ATELIER · 环境变量示例
# 用法：cp .env.example .env.local 然后填值
# ─────────────────────────────────────────────

# 应用元信息
NODE_ENV=development
APP_URL=http://localhost:3000

# PostgreSQL 数据库（2.2 子任务接入）
DATABASE_URL=postgresql://atelier:atelier@localhost:5432/atelier?schema=public

# Better Auth（2.3 子任务接入）
AUTH_SECRET=please-generate-a-32-byte-secret
AUTH_TRUST_HOST=true

# 默认管理员（首次启动使用，登录后强制改密）
ADMIN_INIT_EMAIL=owner@atelier.com
ADMIN_INIT_PASSWORD=ChangeMe-On-First-Login

# 文件上传（2.4 子任务接入）
UPLOAD_DIR=./uploads
UPLOAD_MAX_MB=20

# 站点配置
NEXT_PUBLIC_SITE_NAME=ATELIER
NEXT_PUBLIC_DEFAULT_LOCALE=zh
